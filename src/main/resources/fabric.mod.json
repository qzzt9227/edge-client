{
	"schemaVersion": 1,
	"id": "client",
	"version": "${version}",
	"name": "Edge Client",
	"description": "An extensible, settings-driven client mod with a reusable Click GUI API.",
	"authors": [
		"ie155"
	],
	"license": "MIT",
	"icon": "assets/client/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.qzz.iie.Client"
		],
		"fabric-datagen": [
			"io.qzz.iie.ClientDataGenerator"
		]
	},
	"mixins": [
		"client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
